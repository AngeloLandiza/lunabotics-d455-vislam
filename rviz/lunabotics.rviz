Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Reference Frame: map
      Plane: XY
      Plane Cell Count: 40
      Cell Size: 0.5
      Line Style:
        Line Width: 0.03
        Value: Lines
      Color: 58; 62; 72
      Alpha: 0.6
      Normal Cell Count: 0
      Offset:
        X: 0
        Y: 0
        Z: 0
    - Class: rviz_default_plugins/PointCloud2
      Name: SLAM cloud
      Enabled: false
      Topic:
        Value: /cloud_map
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
      Style: Squares
      Size (m): 0.045
      Size (Pixels): 3
      Alpha: 1
      Decay Time: 0
      Position Transformer: XYZ
      Color Transformer: AxisColor
      Axis: Z
      Use Fixed Frame: true
      Use rainbow: true
      Invert Rainbow: false
      Autocompute Value Bounds: true
      Queue Size: 2
      Selectable: false
    - Class: rviz_default_plugins/PointCloud2
      Name: Terrain height
      Enabled: true
      Topic:
        Value: /terrain/cloud
        Depth: 1
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
      Style: Squares
      Size (m): 0.05
      Alpha: 1
      Decay Time: 0
      Position Transformer: XYZ
      Color Transformer: Intensity
      Channel Name: elevation
      Use rainbow: true
      Invert Rainbow: false
      Autocompute Intensity Bounds: true
      Queue Size: 2
      Selectable: false
    - Class: rviz_default_plugins/PointCloud2
      Name: Dig (blue) / dump (red)
      Enabled: false
      Topic:
        Value: /terrain/cloud
        Depth: 1
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
      Style: Squares
      Size (m): 0.05
      Alpha: 1
      Decay Time: 0
      Position Transformer: XYZ
      Color Transformer: Intensity
      Channel Name: change
      Use rainbow: true
      Invert Rainbow: true
      Autocompute Intensity Bounds: false
      Min Intensity: -0.3
      Max Intensity: 0.3
      Queue Size: 2
      Selectable: false
    - Class: rviz_default_plugins/PointCloud2
      Name: Live scan
      Enabled: false
      Topic:
        Value: /lidar/points
        Depth: 1
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
      Style: Points
      Size (Pixels): 2
      Alpha: 0.9
      Decay Time: 0
      Position Transformer: XYZ
      Color Transformer: FlatColor
      Color: 235; 240; 255
      Queue Size: 2
      Selectable: false
    - Class: rviz_default_plugins/Path
      Name: Trajectory
      Enabled: true
      Topic:
        Value: /vislam/trajectory
        Depth: 1
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
      Line Style: Billboards
      Line Width: 0.03
      Color: 255; 70; 160
      Alpha: 1
      Buffer Length: 1
      Pose Style: None
      Offset:
        X: 0
        Y: 0
        Z: 0
    - Class: rviz_default_plugins/Marker
      Name: Camera
      Enabled: true
      Topic:
        Value: /vislam/camera_marker
        Depth: 1
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
      Namespaces:
        camera: true
    - Class: rviz_default_plugins/Axes
      Name: Camera axes
      Enabled: true
      Reference Frame: camera_link
      Length: 0.15
      Radius: 0.012
      Value: true
  Enabled: true
  Global Options:
    Background Color: 20; 22; 27
    Fixed Frame: map
    Frame Rate: 60
  Name: root
  Tools:
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Interact
      Hide Inactive Objects: true
  Transformation:
    Current:
      Class: rviz_default_plugins/TF
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Name: Current View
      Target Frame: <Fixed Frame>
      Distance: 7
      Focal Point:
        X: 1.5
        Y: 0
        Z: 0
      Focal Shape Fixed Size: false
      Focal Shape Size: 0.05
      Near Clip Distance: 0.01
      Pitch: 0.75
      Yaw: 3.6
      Value: Orbit (rviz)
    Saved: ~
Window Geometry:
  Hide Left Dock: true
  Hide Right Dock: true
  Height: 760
  Width: 1100
  X: 60
  Y: 60
